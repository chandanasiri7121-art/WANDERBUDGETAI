# WanderBudget AI — Environment Variables
# Garudaiahgari Sai Siri Chandana (24BAI0226) | BCSE302P Database Systems Lab
# Copy this file to backend/.env and fill in real values before running the application.

PORT=5001
# Comma-separated browser origins allowed to call this API. Required in production.
FRONTEND_ORIGINS="https://app.example.com"
DATABASE_URL="postgresql://postgres:replace-with-local-password@localhost:5432/wanderbudget_24BAI0226?schema=public"
JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-characters"
GEMINI_API_KEY="your-google-gemini-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"
MAPBOX_ACCESS_TOKEN="your-mapbox-access-token-here"
# Render: use HUGGINGFACE_API_TOKEN. HF_TOKEN is supported only for legacy local setups.
HUGGINGFACE_API_TOKEN="your-hugging-face-api-token-here"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-gmail-app-password"
# Dynamic-routing demo only: public Nominatim is paced to one request/second and OSRM is best-effort.
# Production must configure an appropriate hosted or self-hosted service and a real identifying User-Agent.
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org/search"
OSRM_BASE_URL="https://router.project-osrm.org"
NOMINATIM_USER_AGENT="WanderBudgetAI/1.0 (contact: your-email@example.com)"
NODE_ENV="development"
