datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Single Users Table with RBAC (Garudaiahgari Sai Siri Chandana - 24BAI0226)
model User {
  user_id        Int            @id @default(autoincrement())
  reg_no         String         @unique @db.VarChar(50) // Student Reg or Admin ID
  full_name      String         @db.VarChar(150)
  email          String         @unique @db.VarChar(150)
  password_hash  String         @db.VarChar(255)
  role           String         @default("TRAVELER") @db.VarChar(50) // 'TRAVELER' or 'ADMIN'
  home_currency  String         @default("INR") @db.VarChar(10)
  oauth_provider String?        @default("LOCAL") @db.VarChar(50)
  created_at     DateTime       @default(now())

  trips          Trip[]
  expenses       TripExpense[]
  audit_logs     AuditLog[]

  @@index([email])
  @@index([reg_no])
  @@map("users")
}

// 2. Destinations Master
model Destination {
  destination_id   Int                   @id @default(autoincrement())
  city_name        String                @db.VarChar(100)
  country_name     String                @db.VarChar(100)
  currency_code    String                @db.VarChar(10)
  currency_symbol  String                @default("₹") @db.VarChar(10)
  description      String?               @db.Text
  image_url        String?               @db.VarChar(500)
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt

  cost_index       CostOfLivingIndex?
  attractions      Attraction[]
  trips            Trip[]

  @@unique([city_name, country_name])
  @@index([country_name])
  @@map("destinations")
}

// 3. Live AI Cost of Living Indices (Updated via Internet Search / AI Analyzer)
model CostOfLivingIndex {
  cost_index_id                Int          @id @default(autoincrement())
  destination_id               Int          @unique
  accommodation_budget_night   Decimal      @db.Decimal(12, 2) // Hostels / budget dorms
  accommodation_standard_night Decimal      @db.Decimal(12, 2) // 3-star hotels / private Airbnbs
  accommodation_luxury_night   Decimal      @db.Decimal(12, 2) // 5-star resorts / luxury suites
  meal_budget_day              Decimal      @db.Decimal(12, 2) // Street food / local markets
  meal_standard_day            Decimal      @db.Decimal(12, 2) // Mid-range sit-down dining
  meal_luxury_day              Decimal      @db.Decimal(12, 2) // Fine dining / upscale
  transit_pass_day             Decimal      @db.Decimal(12, 2) // Daily metro / bus passes
  taxi_per_km                  Decimal      @db.Decimal(12, 2) // Taxi fare / rideshare per km
  exchange_rate_to_inr         Decimal      @db.Decimal(12, 4) // 1 Local Unit = X INR
  source                       String       @default("LIVE_WEB_SEARCH_AI") @db.VarChar(100)
  confidence_score             Decimal      @default(0.95) @db.Decimal(4, 2)
  last_synced_at               DateTime     @default(now())

  destination                  Destination  @relation(fields: [destination_id], references: [destination_id], onDelete: Cascade)

  @@map("cost_of_living_indices")
}

// 4. Attractions / Places to Visit
model Attraction {
  attraction_id      Int          @id @default(autoincrement())
  destination_id     Int
  name               String       @db.VarChar(200)
  category           String       @db.VarChar(100) // Historical, Nature, Adventure, Culture, Theme Park
  ticket_price_local Decimal      @default(0.0) @db.Decimal(12, 2)
  ticket_price_inr   Decimal      @default(0.0) @db.Decimal(12, 2)
  avg_duration_hours Decimal      @default(2.5) @db.Decimal(4, 1)
  recommended_style  String       @default("ALL") @db.VarChar(50) // BUDGET, STANDARD, LUXURY, ALL
  image_url          String?      @db.VarChar(500)
  description        String?      @db.Text

  destination        Destination  @relation(fields: [destination_id], references: [destination_id], onDelete: Cascade)
  trip_places        TripPlace[]

  @@index([destination_id])
  @@index([category])
  @@map("attractions")
}

// 5. Trips
model Trip {
  trip_id             Int                   @id @default(autoincrement())
  user_id             Int
  destination_id      Int
  title               String                @db.VarChar(200)
  start_date          DateTime?             @db.Date
  end_date            DateTime?             @db.Date
  duration_days       Int                   @default(3) // Duration of stay
  travel_style        String                @default("STANDARD") @db.VarChar(50) // 'BUDGET', 'STANDARD', 'LUXURY'
  group_size          Int                   @default(1) // Number of travelers
  total_budget_inr    Decimal               @db.Decimal(14, 2)
  total_spent_inr     Decimal               @default(0.0) @db.Decimal(14, 2)
  status              String                @default("PLANNING") @db.VarChar(50) // 'PLANNING', 'ACTIVE', 'COMPLETED'
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt

  user                User                  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  destination         Destination           @relation(fields: [destination_id], references: [destination_id], onDelete: Restrict)
  trip_places         TripPlace[]
  budget_breakdowns   TripBudgetBreakdown[]
  expenses            TripExpense[]
  alerts              BudgetAlert[]

  @@index([user_id])
  @@index([destination_id])
  @@map("trips")
}

// 6. Selected Places in a Trip Itinerary
model TripPlace {
  trip_place_id      Int         @id @default(autoincrement())
  trip_id            Int
  attraction_id      Int
  planned_day        Int         @default(1)
  estimated_cost_inr Decimal     @db.Decimal(12, 2)
  notes              String?     @db.Text

  trip               Trip        @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)
  attraction         Attraction  @relation(fields: [attraction_id], references: [attraction_id], onDelete: Cascade)

  @@index([trip_id])
  @@index([attraction_id])
  @@map("trip_places")
}

// 7. Budget Categories (Accommodation, Food, Transit, Sightseeing, Buffer)
model BudgetCategory {
  category_id        Int                   @id @default(autoincrement())
  category_code      String                @unique @db.VarChar(50) // ACCOMMODATION, FOOD, SIGHTSEEING, TRANSIT, BUFFER, MISC
  category_name      String                @db.VarChar(100)
  icon               String                @default("Tag") @db.VarChar(50)

  budget_breakdowns  TripBudgetBreakdown[]
  expenses           TripExpense[]
  alerts             BudgetAlert[]

  @@map("budget_categories")
}

// 8. Trip Budget Category Breakdown
model TripBudgetBreakdown {
  breakdown_id         Int            @id @default(autoincrement())
  trip_id              Int
  category_id          Int
  allocated_amount_inr Decimal        @db.Decimal(12, 2)
  spent_amount_inr     Decimal        @default(0.0) @db.Decimal(12, 2)

  trip                 Trip           @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)
  category             BudgetCategory @relation(fields: [category_id], references: [category_id], onDelete: Restrict)

  @@unique([trip_id, category_id])
  @@index([trip_id])
  @@map("trip_budget_breakdowns")
}

// 9. Actual Trip Expenses Logged During Trip
model TripExpense {
  expense_id       Int            @id @default(autoincrement())
  trip_id          Int
  category_id      Int
  user_id          Int
  expense_name     String         @db.VarChar(200)
  amount_inr       Decimal        @db.Decimal(12, 2)
  currency_code    String         @default("INR") @db.VarChar(10)
  amount_original  Decimal        @db.Decimal(12, 2)
  expense_date     DateTime       @default(now())
  payment_method   String         @default("CARD") @db.VarChar(50) // CASH, CARD, UPI, FOREX
  receipt_url      String?        @db.VarChar(500)
  notes            String?        @db.Text
  created_at       DateTime       @default(now())

  trip             Trip           @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)
  category         BudgetCategory @relation(fields: [category_id], references: [category_id], onDelete: Restrict)
  user             User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([trip_id])
  @@index([category_id])
  @@index([expense_date])
  @@map("trip_expenses")
}

// 10. Automated Trigger-Generated Budget Alerts
model BudgetAlert {
  alert_id          Int            @id @default(autoincrement())
  trip_id           Int
  category_id       Int?
  alert_type        String         @db.VarChar(50) // WARNING_80_PERCENT, CRITICAL_100_PERCENT, BUDGET_EXCEEDED
  message           String         @db.Text
  threshold_pct     Decimal        @db.Decimal(10, 2)
  created_at        DateTime       @default(now())
  is_resolved       Boolean        @default(false)

  trip              Trip           @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)
  category          BudgetCategory? @relation(fields: [category_id], references: [category_id], onDelete: SetNull)

  @@index([trip_id])
  @@map("budget_alerts")
}

// 11. Security Audit Logs for Industry Best Practice
model AuditLog {
  log_id           Int            @id @default(autoincrement())
  user_id          Int?
  action           String         @db.VarChar(100)
  entity_type      String         @db.VarChar(100)
  entity_id        Int?
  ip_address       String?        @db.VarChar(100)
  details          String?        @db.Text
  timestamp        DateTime       @default(now())

  user             User?          @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}
